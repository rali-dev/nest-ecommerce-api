// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "commonjs"
}

datasource db {
  provider = "postgresql"
}

model Blog {
  id         String       @id @default(uuid())
  title      String
  content    String
  image      String
  url        String       @unique
  categoryId String
  category   BlogCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  userId     String
  user       User         @relation(fields: [userId], references: [id])
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([categoryId])
  @@index([userId])
}

model BlogCategory {
  id        String   @id @default(uuid())
  title     String
  content   String
  image     String
  url       String   @unique
  blogs     Blog[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum LogType {
  ERROR
  POST
  PUT
  PATCH
  DELETE
}

model Log {
  id        String   @id @default(uuid())
  content   String
  url       String
  type      LogType
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

enum Role {
  ADMIN
  USER
  COPYWRITER
}

model User {
  id            String   @id @default(uuid())
  firstName     String
  lastName      String
  mobile        String
  email         String   @unique
  password      String
  role          Role     @default(USER)
  logs          Log[]
  blogs         Blog[]
  twoFactorCode String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Seo {
  id             String   @id @default(uuid())
  url            String   @unique
  seoTitle       String
  seoDescription String
  h1             String?
  content        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Product {
  id         String          @id @default(uuid())
  title      String
  content    String
  images     String[]
  thumbnail  String
  price      Decimal         @db.Decimal(10, 2)
  discount   Decimal?        @db.Decimal(10, 2)
  categoryId String
  category   ProductCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  url        String          @unique
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([categoryId])
}

model ProductCategory {
  id        String    @id @default(uuid())
  title     String
  content   String
  image     String
  url       String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}
